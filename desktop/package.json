{
  "name": "multmix",
  "version": "1.2.1",
  "description": "MultMix para computador (Windows): Sistema, Catálogo e PDV, funciona sem internet e imprime o cupom direto.",
  "main": "main.js",
  "author": "MultMix Eletros e Variedades",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "br.com.multmix.pdv",
    "productName": "MultMix",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "store.js",
      "preload.js",
      "preload-app.js",
      "home.html",
      "settings.html",
      "offline.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "MultMix",
      "artifactName": "MultMix-Instalador.${ext}",
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "icons",
        "to": "icons"
      },
      {
        "from": "app-files",
        "to": "app-files"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "multmixeletrosevariedadesnp",
        "repo": "MultMixnp",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}